{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": { "api/**/*.js": { "includeFiles": "data/**" } },
  "rewrites": [{ "source": "/api/go/:id", "destination": "/api/go?id=:id" }],
  "headers": [{ "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }, { "key": "Access-Control-Allow-Origin", "value": "*" }] }]
}
